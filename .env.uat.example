SPRING_PROFILES_ACTIVE=prod
SERVER_PORT=8080
DB_URL=jdbc:postgresql://<uat-db-host>:5432/rentalapp
DB_USERNAME=<uat-db-user>
DB_PASSWORD=<uat-db-password>
APP_CORS_ALLOWED_ORIGINS=https://<uat-frontend-host>
APP_MEDIA_STORAGE_PATH=/var/lib/rentalapp/media
APP_MEDIA_PUBLIC_BASE_URL=https://<uat-api-host>
JWT_SECRET=replace-with-a-long-base64-or-random-secret
JWT_ACCESS_TOKEN_EXPIRATION_MS=3600000
JWT_REFRESH_TOKEN_EXPIRATION_MS=604800000
